# Server-side only (Vercel environment variables). Never commit a real API key.
#
# AI provider chain (api/_lib/ai-chat.js). Every AI endpoint tries the providers whose keys
# are set, in this order, and moves to the next one when a provider is rate-limited, down or
# slow. Each has its own free allowance, so adding keys raises the app's daily ceiling.

# 1. Groq — primary. Free tier is roughly 1,000 requests / 200K tokens per day per account.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Used when the user explicitly asks for a live demo/video or current web information,
# and as the final overflow model when every other provider is exhausted.
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_FALLBACK_MODEL=groq/compound-mini

# 2. Cerebras — free tier is roughly 1M tokens per day, larger gpt-oss-120b model.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# 3. Cloudflare Workers AI — 10,000 free neurons per day (roughly 80–200 replies).
# Needs both values; create an API token with the Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 4. OpenRouter — optional. 50 free-model requests per day, 1,000 after a one-time $10 top-up.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
