# Server-side only. Never commit a real API key.
GROQ_API_KEY=

# Current production default used by Iron Six Coach.
GROQ_MODEL=openai/gpt-oss-20b

# Used when the user explicitly asks for a live demo/video or current web information.
GROQ_SEARCH_MODEL=groq/compound-mini

# Optional. In-app Android updates read this repository's public GitHub Releases. A token (no scopes
# needed for a public repo) lifts GitHub's 60 requests/hour unauthenticated limit.
GITHUB_TOKEN=

# Optional. Android builds below this versionCode see a persistent "no longer supported" banner.
MIN_ANDROID_BUILD=
